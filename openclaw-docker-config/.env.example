# ─────────────────────────────────────────────────────────────────────────────
# openclaw-docker-config/.env.example
#
# Copy to `.env` (never commit `.env`) and fill in local paths.
#
# Secrets (gateway tokens, Slack, Perplexity) are NOT meant to live here.
# `launch-openclaw.sh` loads them from the macOS Keychain into mode-0600 files
# under ${OPENCLAW_SECRETS_DIR:-$HOME/.openclaw-secrets}/ and exports
# PERPLEXITY_API_KEY into the compose process environment only.
#
# Compose variable substitutions used by docker-compose.yml:
#   HOST_PROJECTS_ROOT, CONTAINER_PROJECTS_ROOT, PERPLEXITY_API_KEY, HOME
# Optional launcher overrides (not required in .env for compose config):
#   OPENCLAW_SECRETS_DIR, OPENCLAW_KEYCHAIN_ACCOUNT
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Host directory of project repos mounted into cell 3 (main) and the executor.
# Must exist before first launch; launch-openclaw.sh creates .worktrees under it.
HOST_PROJECTS_ROOT=~/path/to/your/projects

# In-container mount path for those projects (must match agent tooling paths).
CONTAINER_PROJECTS_ROOT=/home/node/projects

# ── Optional (compose / launcher) ────────────────────────────────────────────
# Perplexity search key (https://www.perplexity.ai/api-platform).
# Prefer Keychain entry `openclaw-perplexity-api-key`
# via launch-openclaw.sh. If you must interpolate without the launcher, set a
# real value here locally — never commit it. Empty is valid: perplexity-mcp
# starts without search.
# PERPLEXITY_API_KEY=

# Override where launch-openclaw.sh writes the 0600 secrets JSON files.
# Default: $HOME/.openclaw-secrets
# OPENCLAW_SECRETS_DIR=

# macOS Keychain account name used by launch-openclaw.sh (default: $USER).
# OPENCLAW_KEYCHAIN_ACCOUNT=

# ── Do NOT put these in .env ─────────────────────────────────────────────────
# Gateway auth tokens, Slack bot/app tokens, Linear tokens, and other
# credentials belong in Keychain (or your secret store) and are materialised
# as:
#   $HOME/.openclaw-secrets/openclaw-secrets.json
#   $HOME/.openclaw-secrets/scout-secrets.json
#   $HOME/.openclaw-secrets/curator-secrets.json
# Compose mounts those files via the top-level `secrets:` block (${HOME}/...).
