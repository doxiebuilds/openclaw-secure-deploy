{
  "secrets": {
    "providers": {
      "default": {
        "source": "env"
      },
      "docker-secrets": {
        "source": "file",
        "path": "/run/secrets/openclaw_secrets",
        "mode": "json",
        "timeoutMs": 5000,
        "maxBytes": 65536
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "enabled": true
      }
    },
    "entries": {
      "weather": {
        "enabled": false
      },
      "academic-deep-research": {
        "enabled": false
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": "qwen-local/qwen/qwen3.6-35b-a3b",
      "memorySearch": {
        "enabled": true,
        "provider": "none",
        "sources": [
          "memory"
        ],
        "extraPaths": [
          "/home/node/.openclaw/workspace/memory"
        ]
      },
      "compaction": {
        "reserveTokensFloor": 35000
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "sandbox": {
        "mode": "off"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 5,
        "maxConcurrent": 4,
        "runTimeoutSeconds": 900,
        "delegationMode": "suggest"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "description": "Trusted work. Repo read/write, wrapper exec, reads briefs. NO web tools.",
        "workspace": "/home/node/.openclaw/workspace",
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "memory_search",
            "memory_get",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "session_status",
            "get_goal",
            "create_goal",
            "update_goal",
            "update_plan",
            "skill_workshop",
            "linear__list_teams",
            "linear__list_issues",
            "linear__list_projects"
          ],
          "deny": [
            "web_fetch",
            "web_search",
            "x_search",
            "code_execution",
            "cron"
          ]
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": {
        "source": "file",
        "provider": "docker-secrets",
        "id": "/gateway/authToken"
      },
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "port": 18789,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false,
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding",
    "exec": {
      "mode": "auto",
      "strictInlineEval": true
    },
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 5,
      "criticalThreshold": 8,
      "unknownToolThreshold": 5,
      "globalCircuitBreakerThreshold": 15,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      },
      "postCompactionGuard": {
        "windowSize": 2
      }
    },
    "web": {
      "search": {
        "enabled": false
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen-local": {
        "baseUrl": "http://qwen-forward:1234/v1",
        "apiKey": "dummy",
        "api": "openai-completions",
        "timeoutSeconds": 180,
        "models": [
          {
            "id": "qwen/qwen3.6-35b-a3b",
            "name": "Qwen 3.6 35B A3B",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "groupPolicy": "allowlist",
      "channels": {
        "C_EXAMPLE_MAIN": {
          "enabled": true,
          "requireMention": false,
          "users": [
            "U_EXAMPLE_OWNER"
          ]
        },
        "C_EXAMPLE_ALERTS": {
          "enabled": true,
          "requireMention": false,
          "users": [
            "U_EXAMPLE_OWNER"
          ]
        },
        "C_EXAMPLE_DEV": {
          "enabled": true,
          "requireMention": false,
          "users": [
            "U_EXAMPLE_OWNER"
          ]
        }
      },
      "botToken": {
        "source": "file",
        "provider": "docker-secrets",
        "id": "/slack/botToken"
      },
      "appToken": {
        "source": "file",
        "provider": "docker-secrets",
        "id": "/slack/appToken"
      },
      "streaming": {
        "mode": "progress",
        "progress": {
          "render": "rich"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "linear": {
        "url": "https://mcp.linear.app/mcp/readonly",
        "transport": "streamable-http",
        "auth": "oauth",
        "oauth": {
          "scope": "read"
        },
        "requestTimeoutMs": 20000,
        "connectionTimeoutMs": 5000,
        "toolFilter": {
          "exclude": [
            "*create_*",
            "*update_*",
            "*delete_*",
            "*archive_*",
            "*remove_*"
          ]
        }
      }
    }
  },
  "plugins": {
    "allow": [
      "slack",
      "active-memory",
      "memory-wiki",
      "build-guard"
    ],
    "bundledDiscovery": "compat",
    "entries": {
      "memory-core": {
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "qwen-local/qwen/qwen3.6-35b-a3b"
          ]
        },
        "config": {
          "dreaming": {
            "enabled": true,
            "model": "qwen-local/qwen/qwen3.6-35b-a3b"
          }
        }
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "enabled": true,
          "agents": [
            "main"
          ],
          "allowedChatTypes": [
            "direct"
          ],
          "model": "qwen-local/qwen/qwen3.6-35b-a3b",
          "modelFallback": "qwen-local/qwen/qwen3.6-35b-a3b",
          "queryMode": "recent",
          "promptStyle": "balanced",
          "timeoutMs": 15000,
          "maxSummaryChars": 220,
          "persistTranscripts": false,
          "logging": true
        }
      },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "vaultMode": "isolated",
          "vault": {
            "path": "/home/node/.openclaw/wiki/main",
            "renderMode": "native"
          },
          "bridge": {
            "enabled": false
          },
          "unsafeLocal": {
            "allowPrivateMemoryCoreAccess": false
          },
          "ingest": {
            "autoCompile": true,
            "allowUrlIngest": false
          }
        }
      }
    },
    "load": {
      "paths": [
        "/home/node/plugins/build-guard"
      ]
    }
  }
}
