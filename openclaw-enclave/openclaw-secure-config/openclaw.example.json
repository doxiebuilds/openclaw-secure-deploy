{
  "secrets": {
    "providers": {
      "default": {
        "source": "env"
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "memorySearch": {
        "enabled": true,
        "provider": "none"
      },
      "compaction": {
        "reserveTokensFloor": 35000
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "sandbox": {
        "mode": "off",
        "backend": "docker",
        "workspaceAccess": "rw",
        "workspaceRoot": "/path/to/your/openclaw/openclaw-enclave/workspace",
        "docker": {
          "image": "openclaw-sandbox-jstest:latest",
          "network": "none",
          "capDrop": [
            "ALL"
          ]
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_AUTH_TOKEN"
      },
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "port": 18789,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false,
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding",
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 5,
      "criticalThreshold": 8,
      "unknownToolThreshold": 5,
      "globalCircuitBreakerThreshold": 15,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      },
      "postCompactionGuard": {
        "windowSize": 2
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo"
      }
    }
  },
  "wizard": {
    "securityAcknowledgedAt": "2026-07-14T00:48:07.730Z",
    "lastRunAt": "2026-07-14T02:46:29.587Z",
    "lastRunVersion": "2026.7.1",
    "lastRunCommand": "onboard",
    "lastRunMode": "local"
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-07-14T03:00:52.423Z"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen-local": {
        "baseUrl": "http://host.docker.internal:1234/v1",
        "apiKey": "dummy",
        "api": "openai-completions",
        "timeoutSeconds": 180,
        "models": [
          {
            "id": "qwen/qwen3.6-35b-a3b",
            "name": "Qwen 3.6 35B A3B",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "groupPolicy": "allowlist",
      "channels": {
        "YOUR_CHANNEL_ID_1": {
          "enabled": true,
          "requireMention": false,
          "users": [
            "YOUR_USER_ID"
          ]
        },
        "YOUR_CHANNEL_ID_2": {
          "enabled": true,
          "requireMention": false,
          "users": [
            "YOUR_USER_ID"
          ]
        }
      },
      "botToken": {
        "source": "env",
        "provider": "default",
        "id": "SLACK_BOT_TOKEN"
      },
      "appToken": {
        "source": "env",
        "provider": "default",
        "id": "SLACK_APP_TOKEN"
      },
      "streaming": {
        "mode": "progress",
        "progress": {
          "render": "rich"
        }
      }
    }
  },
  "plugins": {
    "allow": [
      "slack",
      "active-memory",
      "memory-wiki"
    ],
    "bundledDiscovery": "compat",
    "entries": {
      "memory-core": {
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "qwen-local/qwen/qwen3.6-35b-a3b"
          ]
        },
        "config": {
          "dreaming": {
            "enabled": true,
            "model": "qwen-local/qwen/qwen3.6-35b-a3b"
          }
        }
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "enabled": true,
          "agents": [
            "main"
          ],
          "allowedChatTypes": [
            "direct"
          ],
          "model": "qwen-local/qwen/qwen3.6-35b-a3b",
          "modelFallback": "qwen-local/qwen/qwen3.6-35b-a3b",
          "queryMode": "recent",
          "promptStyle": "balanced",
          "timeoutMs": 15000,
          "maxSummaryChars": 220,
          "persistTranscripts": false,
          "logging": true
        }
      }
    }
  }
}
